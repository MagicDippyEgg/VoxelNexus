; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="VoxelNexus"
config/description="A cross-platform voxel sandbox game with physics interactions and LAN multiplayer. Explore procedurally generated dimensional rifts, build structures, and play with friends."
config/version="0.1.0"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
config/disable_viewport_occlusion=false

[autoload]

NetworkManager="*res://autoload/network_manager.gd"
WorldManager="*res://autoload/world_manager.gd"
ProgressManager="*res://autoload/progress_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
GameSettings="*res://autoload/game_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/default_font_antialiasing=1

